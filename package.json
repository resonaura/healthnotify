{
  "name": "healthnotify",
  "version": "1.0.0",
  "description": "Telegram Health Reminder Bot with reliable persistent scheduling, progressive snooze, and family group delivery",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "setup": "tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts tests",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.{ts,js,json}\" \"scripts/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\" \"*.json\" \"*.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{ts,js,json}\" \"scripts/**/*.{ts,js,json}\" \"tests/**/*.{ts,js,json}\" \"*.json\" \"*.md\" \"docs/**/*.md\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx scripts/migrate.ts",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.3.1",
    "grammy": "^1.40.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.18.0",
    "@vitest/coverage-v8": "^4.1.3",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3"
  }
}
